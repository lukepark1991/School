#include<iostream>
#include<fstream>
#include<iomanip>
#include<cmath>
#include<climits>
using namespace std;

const float stopFee = 15.00;
const float perkm = 2.60;
const float discount = 0.75;
float cheaptrip = INT_MAX;





int main()
{
	ifstream fileReader;
	ofstream fileWriter;
	fileReader. open("taxi.txt");
	fileWriter. open("taxiReport1.txt");
	if(fileReader.is_open()&&fileWriter.is_open())
	{
		fileWriter<<setw(8)<<"Trip#"<<setw(10)<<"VIP"<<
		setw(8)<<"Stop#"<<setw(10)<<"Distance"<<setw(10)<<"Charge"<<setw(10)<<"TotalDist"<<setw(13)<<"TotalCharge"<<endl;\
	
		int numstop=0;
		int tripnum =0;
		int vip=0;
		float longtrip=0;
		float totaldist=0;
		float totalcharge=0;
		while(fileReader>>vip>>numstop)
		{
		
			int i=0;
			float dist=0;
			float charge=0;
			float curx=0;
			float cury=0;
			float prevx=0;
			float prevy=0; 		
		
		
			tripnum++;
		
		
					for(i=0;i<numstop;i++)
					{
						fileReader>>curx>>cury;
						dist = dist+sqrt((pow(curx-prevx,2))+(pow(cury-prevy,2)));
						prevx=curx;
						prevy=cury;
					}
					dist=dist+sqrt(pow(curx,2)+pow(cury,2));
					totaldist=dist+totaldist;
					charge=((dist*perkm)+(stopFee*numstop));
					
					if(vip==1)
					{
						charge=discount*charge;
					}
					if(vip==0)
					{
						charge=charge;
					}
					totalcharge=charge+totalcharge;
						
					if(cheaptrip>charge)
					{
						cheaptrip=charge;
					}
					
						if(dist>longtrip)
					{
						longtrip=dist;
					}	
					
					if(tripnum<=4||tripnum%10==4)
					{
				
					fileWriter<<fixed<<setprecision(2)<<setw(8)<<tripnum<<
									setw(8)<<vip<<setw(8)<<numstop<<setw(10)<<dist<<setw(10)
									<<charge<<setw(10)<<totaldist<<setw(13)<<totalcharge<<endl;\
			}
		}
		
	fileWriter<<setw(10)<<"Total distance in August: "<<totaldist<<"km"<<endl;
	fileWriter<<setw(10)<<"Total charge in August: $"<<totalcharge<<endl;
	fileWriter<<setw(10)<<"Longes Trip in August: "<<longtrip<<"km"<<endl;
	fileWriter<<setw(10)<<"Cheapest Trip in August: $"<<cheaptrip<<endl;
	fileReader. close();
	fileWriter. close();
	
	}
	else
	{
		cout<<"Trouble opening the file"<<endl;	
	}
	return 0;
	
}

